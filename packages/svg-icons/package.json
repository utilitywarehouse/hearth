{
  "name": "@utilitywarehouse/hearth-svg-icons",
  "version": "0.10.0",
  "description": "Hearth SVG icons",
  "author": "Design Systems <design-systems@uw.co.uk>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utilitywarehouse/hearth.git",
    "directory": "packages/svg-icons"
  },
  "scripts": {
    "clean:lib": "rm -rf lib",
    "format": "prettier --log-level=silent --write --parser=html \"lib/*.svg\"",
    "format:ci": "prettier --list-different --parser=html \"lib/*.svg\"",
    "generate": "pnpm clean:lib && node ./scripts/generate-svg-icons.js && pnpm generate:manifest",
    "test": "vitest run",
    "generate:manifest": "node ./scripts/generate-icons-manifest.mjs",
    "sync:manifest-version": "pnpm generate:manifest"
  },
  "devDependencies": {
    "@utilitywarehouse/hearth-manifest": "workspace:*",
    "cheerio": "1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.1.1",
    "lodash": "^4.18.1",
    "svgo": "^3.0.2",
    "vitest": "^4.1.7"
  },
  "files": [
    "lib",
    "hearth-manifest.json"
  ]
}
