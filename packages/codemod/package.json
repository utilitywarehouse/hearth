{
  "name": "@utilitywarehouse/hearth-codemod",
  "version": "0.0.0",
  "description": "Codemods for migrating consumers between major versions of Hearth packages",
  "author": "Design Systems <design-systems@uw.co.uk>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utilitywarehouse/hearth.git",
    "directory": "packages/codemod"
  },
  "bin": {
    "hearth-codemod": "./dist/cli.js"
  },
  "scripts": {
    "clean": "rm -rf node_modules && rm -rf dist",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint:fix": "TIMING=1 eslint --fix --ext ts,tsx src && pnpm format",
    "lint": "TIMING=1 eslint --ext ts,tsx src",
    "format": "prettier --write \"src/**/*.ts*\"",
    "format:ci": "prettier --list-different \"src/**/*.ts*\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "jscodeshift": "^17.4.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^22.9.0",
    "@types/yargs": "^17.0.35",
    "tsup": "^8.5.1",
    "vitest": "^4.1.7"
  },
  "files": [
    "dist",
    "src/transforms"
  ]
}
