{
  "name": "@utilitywarehouse/hearth-json-assets",
  "version": "0.6.1",
  "description": "Hearth JSON assets",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utilitywarehouse/hearth.git",
    "directory": "packages/json-assets"
  },
  "scripts": {
    "clean:lib": "rm -rf lib",
    "gen:script": "node ./scripts/generate-json-assets.js",
    "generate": "pnpm clean:lib && pnpm gen:script && pnpm generate:manifest",
    "generate:manifest": "pnpm --filter @utilitywarehouse/hearth-manifest build && node ./scripts/generate-hearth-manifest.mjs",
    "sync:manifest-version": "pnpm generate:manifest",
    "test": "vitest run"
  },
  "devDependencies": {
    "@utilitywarehouse/hearth-manifest": "workspace:*",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.1.1",
    "node-fetch": "^2.7.0",
    "vitest": "^4.1.7"
  },
  "files": [
    "lib",
    "hearth-manifest.json"
  ]
}
