{
  "name": "@utilitywarehouse/hearth-cli",
  "version": "0.0.0",
  "description": "Look up Hearth tokens from the versions installed in your project",
  "author": "Design Systems <design-systems@uw.co.uk>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utilitywarehouse/hearth.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "hearth": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@utilitywarehouse/hearth-json-assets": "*",
    "@utilitywarehouse/hearth-react-icons": "*",
    "@utilitywarehouse/hearth-react-native-icons": "*",
    "@utilitywarehouse/hearth-svg-assets": "*",
    "@utilitywarehouse/hearth-svg-icons": "*",
    "@utilitywarehouse/hearth-tokens": "*"
  },
  "peerDependenciesMeta": {
    "@utilitywarehouse/hearth-json-assets": {
      "optional": true
    },
    "@utilitywarehouse/hearth-react-icons": {
      "optional": true
    },
    "@utilitywarehouse/hearth-react-native-icons": {
      "optional": true
    },
    "@utilitywarehouse/hearth-svg-assets": {
      "optional": true
    },
    "@utilitywarehouse/hearth-svg-icons": {
      "optional": true
    },
    "@utilitywarehouse/hearth-tokens": {
      "optional": true
    }
  },
  "scripts": {
    "clean": "rm -rf node_modules && rm -rf dist",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint:fix": "TIMING=1 eslint --fix --ext ts,tsx src && pnpm format",
    "lint": "TIMING=1 eslint --ext ts,tsx src",
    "lint:ci": "TIMING=1 eslint --ext ts,tsx src",
    "format": "prettier --write \"src/**/*.ts*\"",
    "format:ci": "prettier --list-different \"src/**/*.ts*\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@utilitywarehouse/hearth-manifest": "workspace:*",
    "tsup": "^8.5.1",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  },
  "files": [
    "dist"
  ]
}
