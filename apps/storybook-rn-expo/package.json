{
  "name": "hearth-react-native-expo",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "main": "index.js",
  "scripts": {
    "build:preview:android": "eas build --profile preview -p android --local --output './build/hearth-react-native.apk' --local",
    "build:development:android": "eas build --profile development -p android --local",
    "build:development-sim:android": "eas build --profile development-simulator -p android --local",
    "build:preview:ios": "EAS_LOCAL_BUILD_WORKINGDIR='./eas-build' eas build --profile preview -p ios --local --output './build/hearth-react-native.tar.gz'",
    "build:development:ios": "eas build --profile development -p ios --local",
    "build:development-sim:ios": "eas build --profile development-simulator -p ios --local",
    "eas-build-pre-install": "echo '//registry.npmjs.org/:_authToken=${NPM_TOKEN}' > temp.txt && echo 'registry=https://registry.npmjs.org/' >> temp.txt && cat ../../.npmrc >> temp.txt && mv temp.txt ../../.npmrc",
    "eas-build-post-install": "if [[ \"$OSTYPE\" == \"darwin\"* ]]; then sed -i '.bak' '/\\/\\/registry.npmjs.org\\/:_authToken=${NPM_TOKEN}/d' ../../.npmrc && sed -i '.bak' '/registry=https:\\/\\/registry.npmjs.org\\//d' ../../.npmrc && rm ../../.npmrc.bak; else sed -i '/\\/\\/registry.npmjs.org\\/:_authToken=${NPM_TOKEN}/d' ../../.npmrc && sed -i '/registry=https:\\/\\/registry.npmjs.org\\//d' ../../.npmrc; fi",
    "prebuild": "expo prebuild --clean",
    "dev": "expo start",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "chromatic:build:ios": "chromatic react-native-build --platform=ios --output-dir=build",
    "chromatic:build:android": "chromatic react-native-build --platform=android --output-dir=build",
    "clean": "rm -rf node_modules storybook-static .turbo"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.9",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@storybook/addon-ondevice-actions": "10.5.4",
    "@storybook/addon-ondevice-controls": "10.5.4",
    "@storybook/react-native": "^10.5.4",
    "@types/react": "~19.2.18",
    "@utilitywarehouse/hearth-react-native": "workspace:^",
    "@utilitywarehouse/hearth-react-native-icons": "workspace:^",
    "@utilitywarehouse/hearth-storybook-utils": "workspace:*",
    "@utilitywarehouse/hearth-svg-assets": "workspace:^",
    "@utilitywarehouse/hearth-tokens": "workspace:^",
    "expo": "57.0.12",
    "expo-constants": "57.0.10",
    "expo-dev-client": "57.0.11",
    "expo-font": "57.0.1",
    "expo-splash-screen": "57.0.6",
    "expo-xml-font": "^3.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-edge-to-edge": "1.6.1",
    "react-native-gesture-handler": "2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-nitro-modules": "0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-unistyles": "3.3.0",
    "react-native-web": "^0.21.1",
    "react-native-worklets": "0.10.1",
    "storybook": "^10.5.6"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "babel-loader": "^9.1.3",
    "cross-env": "^7.0.3",
    "eas-cli": "^22.0.0",
    "react-native-svg-transformer": "^1.5.1",
    "typescript": "6.0.3"
  }
}
